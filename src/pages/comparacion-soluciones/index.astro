---
import '../../styles/custom.css';
import SiteHeader from '../../components/SiteHeader.astro';
import { Content } from '../../../investigacion/Comparacion_Soluciones_Existentes_S04.md';

const base = import.meta.env.BASE_URL;
const description = 'Documento de Análisis comparativo y oportunidades de reutilización.';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>Comparación de soluciones existentes · Data Lens</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al documento</a>
    <SiteHeader />
    <main id="contenido" class="document-layout">
      <a class="back-link" href={base}>← Volver a planificación</a>
      <div class="document-top">
        <p>{description}</p>
        <a class="download-link" href={`${base}descargas/Comparacion_Soluciones_Existentes_S04.md`} download>Descargar Markdown ↓</a>
      </div>
      <article class="document-content comparison-report"><Content /></article>
    </main>
  </body>
</html>

<style>
  .comparison-report :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
