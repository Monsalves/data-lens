---
import '../../styles/custom.css';
import rows from '../../data/aws-map.json';
import SiteHeader from '../../components/SiteHeader.astro';

const base = import.meta.env.BASE_URL;
const pillars = [...new Set(rows.map((row) => row.pillar))];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Mapa preliminar de pilares, dimensiones y servicios AWS para el assessment de datos Data Lens." />
    <title>Servicios AWS · Data Lens</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <style>
      .aws-wrap{max-width:1160px;margin:0 auto;padding:2rem 1.25rem 4rem}
      .aws-note{border-left:4px solid #1f8b89;background:#eaf5f2;padding:.8rem 1rem;margin:1.25rem 0 1.75rem;line-height:1.5}
      .aws-controls{display:flex;gap:1rem;flex-wrap:wrap;align-items:end;margin-bottom:1rem}
      .aws-controls label{display:grid;gap:.35rem;font-weight:600}
      .aws-controls input,.aws-controls select{min-width:230px;max-width:100%;padding:.65rem;border:1px solid #9eb6b8;border-radius:8px;background:#fff;font:inherit}
      .aws-table-wrap{overflow:auto;border:1px solid #cfdddd;border-radius:10px;background:#fff}
      .aws-table{border-collapse:collapse;width:100%;min-width:850px}
      .aws-table th,.aws-table td{padding:.85rem;vertical-align:top;border-bottom:1px solid #dce7e7;text-align:left;line-height:1.45}
      .aws-table thead{background:#e8f2f1}
      .aws-table tbody tr:last-child td{border-bottom:0}
      .aws-table tbody tr:hover{background:#f4f9f8}
    </style>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader />
    <main id="contenido" class="aws-wrap">
      <a class="back-link" href={base}>← Volver a planificación</a>
      <div class="document-top"><div><span class="eyebrow">DOCUMENTO / INVESTIGACIÓN S03</span><h1>Mapa preliminar de servicios AWS</h1></div><a class="download-link" href={`${base}descargas/Servicios_AWS_S03_borrador.md`} download>Descargar Markdown ↓</a></div>
      <p class="aws-note"><strong>Borrador incompleto.</strong> Los servicios son candidatos y todavía no se han validado en una cuenta AWS.</p>
      <div class="aws-controls">
        <label for="pillar-filter">Pilar<select id="pillar-filter"><option value="">Todos</option>{pillars.map((pillar) => <option value={pillar}>{pillar}</option>)}</select></label>
        <label for="aws-search">Buscar dimensión o servicio<input id="aws-search" type="search" placeholder="Ej. linaje, Glue…" /></label>
        <output id="aws-count" aria-live="polite">{rows.length} dimensiones</output>
      </div>
      <div class="aws-table-wrap" role="region" tabindex="0" aria-label="Mapa de servicios AWS, desplazable horizontalmente">
        <table class="aws-table">
          <thead><tr><th scope="col">Pilar</th><th scope="col">Dimensión</th><th scope="col">Servicio AWS candidato</th></tr></thead>
          <tbody>{rows.map((row) => <tr data-pillar={row.pillar} data-search={`${row.pillar} ${row.dimension} ${row.services}`}><td>{row.pillar}</td><td>{row.dimension}</td><td>{row.services}</td></tr>)}</tbody>
        </table>
      </div>
    </main>
    <script>
      const pillar = document.querySelector<HTMLSelectElement>('#pillar-filter');
      const search = document.querySelector<HTMLInputElement>('#aws-search');
      const count = document.querySelector<HTMLOutputElement>('#aws-count');
      const rows = [...document.querySelectorAll<HTMLTableRowElement>('.aws-table tbody tr')];
      const norm = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es');
      function filter() {
        const term = norm(search?.value.trim() ?? '');
        const selected = pillar?.value ?? '';
        let visible = 0;
        for (const row of rows) {
          row.hidden = (selected !== '' && row.dataset.pillar !== selected) || !norm(row.dataset.search ?? '').includes(term);
          if (!row.hidden) visible++;
        }
        if (count) count.textContent = `${visible} ${visible === 1 ? 'dimensión' : 'dimensiones'}`;
      }
      pillar?.addEventListener('change', filter);
      search?.addEventListener('input', filter);
    </script>
  </body>
</html>
