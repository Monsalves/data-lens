---
import '../styles/custom.css';
import PlanningBoard from './PlanningBoard.astro';
import SiteHeader from './SiteHeader.astro';
import planning from '../data/planning.json';

const base = import.meta.env.BASE_URL;
const dateLabel = (value: string) => new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
const firstDate = planning.activities[0]?.start;
const lastDate = planning.activities.at(-1)?.end;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f8f8" />
    <meta name="description" content="Planificación semanal de Data Lens: actividades, estados, fechas y evidencias." />
    <title>Planificación · Data Lens</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar a la planificación</a>
    <SiteHeader />
    <main id="contenido" class="page-content">
      <div class="page-heading">
        <div><span class="eyebrow">DATA LENS / HOJA DE RUTA</span><h1>Planificación del assessment de datos</h1>
        <p class="page-intro">Consulta las actividades, sus entregables y los documentos publicados sin salir del sitio.</p></div>
        {firstDate && lastDate ? <p class="page-summary">{dateLabel(firstDate)} — {dateLabel(lastDate)}</p> : null}
      </div>
      <div class="resource-strip" aria-label="Documentos principales"><span>DOCUMENTOS DEL PROYECTO</span><a href={`${base}metodologia/`}>Marco de trabajo 1.4 →</a><a href={`${base}plantilla/`}>Plantilla F0–F3 →</a><a href={`${base}planificacion-excel/`}>Planificación Excel →</a></div>
      <PlanningBoard />
    </main>
  </body>
</html>
