---
import template from '../data/template-preview.json';
import planning from '../data/planning-preview.json';

type PreviewCell = { text: string; bold: boolean; bg?: string; fg?: string; align?: string; colSpan?: number; rowSpan?: number };
type Sheet = { name: string; rows: (PreviewCell | null)[][] };
const base = import.meta.env.BASE_URL;
const books = [
  { key: 'template', title: 'Plantilla de assessment F0–F3', description: 'Vista de lectura generada desde el Excel publicado.', file: 'Plantilla_Assessment_Datos_F0_F3.xlsx', sheets: template.sheets as Sheet[] },
  { key: 'planning', title: 'Planificación del proyecto', description: 'Vista de lectura generada desde el Excel publicado.', file: 'Planificacion.xlsx', sheets: planning.sheets as Sheet[] }
];
const columnLabel = (index: number) => String.fromCharCode(65 + index);
---
{books.map((book) => <dialog id={`excel-preview-${book.key}`} class="excel-preview" aria-labelledby={`excel-preview-title-${book.key}`}>
  <div class="excel-preview-layout">
    <header class="excel-preview-header">
      <div><h2 id={`excel-preview-title-${book.key}`}>{book.title}</h2><p>{book.description}</p></div>
      <button type="button" class="excel-preview-close" data-close-preview aria-label="Cerrar previsualización">Cerrar ×</button>
    </header>
    <div class="excel-preview-actions"><a href={`${base}descargas/${book.file}`} download>Descargar Excel original ↓</a></div>
    <div class="excel-sheet-tabs" role="tablist" aria-label={`Hojas de ${book.title}`}>
      {book.sheets.map((sheet, index) => <button type="button" role="tab" id={`${book.key}-tab-${index}`} aria-controls={`${book.key}-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-excel-tab={index}>{sheet.name}</button>)}
    </div>
    {book.sheets.map((sheet, index) => <section id={`${book.key}-panel-${index}`} role="tabpanel" aria-labelledby={`${book.key}-tab-${index}`} class="excel-sheet-panel" hidden={index !== 0}>
      <div class="excel-sheet-scroll" tabindex="0" role="region" aria-label={`Hoja ${sheet.name}, desplazable`}>
        <table class="excel-sheet-table" style={`width:calc(3rem + ${sheet.rows[0].length} * 15rem)`}>
          <colgroup><col style="width:3rem" />{sheet.rows[0].map(() => <col style="width:15rem" />)}</colgroup>
          <thead><tr><th scope="col" aria-label="Número de fila"></th>{sheet.rows[0].map((_, col) => <th scope="col">{columnLabel(col)}</th>)}</tr></thead>
          <tbody>{sheet.rows.map((row, rowIndex) => <tr><th scope="row">{rowIndex + 1}</th>{row.map((cell) => cell && <td colspan={cell.colSpan} rowspan={cell.rowSpan} class:list={{ 'excel-cell-bold': cell.bold }} style={`background-color:${cell.bg ?? 'transparent'};color:${cell.fg ?? 'inherit'};text-align:${cell.align ?? 'left'}`}>{cell.text}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </section>)}
  </div>
</dialog>)}
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-excel-preview]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const key = link.dataset.excelPreview;
      const dialog = document.querySelector<HTMLDialogElement>(`#excel-preview-${key}`);
      if (!dialog?.showModal) return;
      event.preventDefault();
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-excel-tab="0"]')?.focus();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.excel-preview').forEach((dialog) => {
    const tabs = [...dialog.querySelectorAll<HTMLButtonElement>('[data-excel-tab]')];
    const panels = [...dialog.querySelectorAll<HTMLElement>('.excel-sheet-panel')];
    function selectSheet(index: number) {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      tabs[index]?.focus();
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectSheet(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
          event.preventDefault();
          selectSheet((index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length);
        }
      });
    });
    dialog.querySelector<HTMLButtonElement>('[data-close-preview]')?.addEventListener('click', () => dialog.close());
  });
</script>
