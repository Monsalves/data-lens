---
import preview from '../data/template-preview.json';

type PreviewCell = { text: string; bold: boolean; bg?: string; fg?: string; align?: string; colSpan?: number; rowSpan?: number };
const sheets = preview.sheets as { name: string; rows: (PreviewCell | null)[][] }[];
const base = import.meta.env.BASE_URL;
const fileUrl = `${base}descargas/Plantilla_Assessment_Datos_F0_F3.xlsx`;
const columnLabel = (index: number) => String.fromCharCode(65 + index);
---
<dialog id="excel-preview" class="excel-preview" aria-labelledby="excel-preview-title">
  <div class="excel-preview-layout">
    <header class="excel-preview-header">
      <div>
        <h2 id="excel-preview-title">Plantilla de assessment F0–F3</h2>
        <p>Vista de lectura generada desde el Excel del repositorio.</p>
      </div>
      <button type="button" class="excel-preview-close" data-close-preview aria-label="Cerrar previsualización">Cerrar ×</button>
    </header>
    <div class="excel-preview-actions"><a href={fileUrl} download>Descargar Excel original ↓</a></div>
    <div class="excel-sheet-tabs" role="tablist" aria-label="Hojas del Excel">
      {sheets.map((sheet, index) => <button type="button" role="tab" id={`excel-tab-${index}`} aria-controls={`excel-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-excel-tab={index}>{sheet.name}</button>)}
    </div>
    {sheets.map((sheet, index) => <section id={`excel-panel-${index}`} role="tabpanel" aria-labelledby={`excel-tab-${index}`} class="excel-sheet-panel" hidden={index !== 0}>
      <div class="excel-sheet-scroll" tabindex="0" role="region" aria-label={`Hoja ${sheet.name}, desplazable`}>
        <table class="excel-sheet-table" style={`width:calc(3rem + ${sheet.rows[0].length} * 15rem)`}>
          <colgroup><col style="width:3rem" />{sheet.rows[0].map(() => <col style="width:15rem" />)}</colgroup>
          <thead><tr><th scope="col" aria-label="Número de fila"></th>{sheet.rows[0].map((_, col) => <th scope="col">{columnLabel(col)}</th>)}</tr></thead>
          <tbody>{sheet.rows.map((row, rowIndex) => <tr><th scope="row">{rowIndex + 1}</th>{row.map((cell) => cell && <td colspan={cell.colSpan} rowspan={cell.rowSpan} class:list={{ 'excel-cell-bold': cell.bold }} style={`background-color:${cell.bg ?? 'transparent'};color:${cell.fg ?? 'inherit'};text-align:${cell.align ?? 'left'}`}>{cell.text}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </section>)}
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#excel-preview');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-excel-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.excel-sheet-panel')];
  function selectSheet(index: number) {
    tabs.forEach((tab, tabIndex) => {
      tab.setAttribute('aria-selected', String(tabIndex === index));
      tab.tabIndex = tabIndex === index ? 0 : -1;
    });
    panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
    tabs[index]?.focus();
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-excel-preview]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!dialog?.showModal) return;
      event.preventDefault();
      dialog.showModal();
      tabs[0]?.focus();
    });
  });
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectSheet(index));
    tab.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        selectSheet((index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length);
      }
    });
  });
  dialog?.querySelector<HTMLButtonElement>('[data-close-preview]')?.addEventListener('click', () => dialog.close());
</script>
