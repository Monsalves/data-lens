[
  {
    "id": "M-01",
    "name": "Responsable informado en catálogo",
    "pillar": "Responsabilidad",
    "dimension": "Responsables",
    "reference": "Activos consultados y campo de responsable disponible en el catálogo.",
    "operations": [
      {
        "name": "GetAsset",
        "service": "Amazon DataZone",
        "method": "GET",
        "endpoint": "https://datazone.{region}.api.aws/v2/domains/{domainIdentifier}/assets/{identifier}",
        "fields": [
          "id",
          "externalIdentifier",
          "formsOutput[].content",
          "formsOutput[].formName",
          "formsOutput[].typeName"
        ],
        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_GetAsset.html"
      },
      {
        "name": "GetFormType",
        "service": "Amazon DataZone",
        "method": "GET",
        "endpoint": "https://datazone.{region}.api.aws/v2/domains/{domainIdentifier}/form-types/{formTypeIdentifier}",
        "fields": [
          "model",
          "name",
          "revision",
          "status"
        ],
        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_GetFormType.html"
      }
    ],
    "formula": "responsables informados ÷ activos revisados",
    "kind": "pct",
    "num": 16,
    "den": 20,
    "unit": "%",
    "num_desc": "16 activos con campo no vacío",
    "den_desc": "20 activos del universo revisado",
    "sample_value": 80,
    "states": null,
    "scope_note": "Comprueba si el campo tiene valor; no confirma que esa persona acepte la responsabilidad."
  },
  {
    "id": "M-04",
    "name": "Solicitudes y concesiones por estado",
    "pillar": "Responsabilidad",
    "dimension": "Políticas de uso",
    "reference": "Solicitudes, suscripciones y grants del dominio y periodo consultados.",
    "operations": [
      {
        "name": "ListSubscriptionRequests",
        "service": "Amazon DataZone",
        "method": "GET",
        "endpoint": "https://datazone.{region}.api.aws/v2/domains/{domainIdentifier}/subscription-requests?status={status}",
        "fields": [
          "items[].id",
          "items[].status",
          "items[].createdAt",
          "items[].updatedAt",
          "items[].reviewerId"
        ],
        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_ListSubscriptionRequests.html"
      },
      {
        "name": "ListSubscriptions",
        "service": "Amazon DataZone",
        "method": "GET",
        "endpoint": "https://datazone.{region}.api.aws/v2/domains/{domainIdentifier}/subscriptions",
        "fields": [
          "items[].id",
          "items[].status",
          "items[].createdAt",
          "items[].subscribedListing.id",
          "items[].subscribedListing.name"
        ],
        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_ListSubscriptions.html"
      },
      {
        "name": "ListSubscriptionGrants",
        "service": "Amazon DataZone",
        "method": "GET",
        "endpoint": "https://datazone.{region}.api.aws/v2/domains/{domainIdentifier}/subscription-grants",
        "fields": [
          "items[].id",
          "items[].subscriptionId",
          "items[].status",
          "items[].assets[].assetId",
          "items[].assets[].assetScope.status"
        ],
        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_ListSubscriptionGrants.html"
      }
    ],
    "formula": "conteos por estado en la ventana",
    "kind": "estados",
    "num": 10,
    "den": 0,
    "unit": "solicitudes",
    "num_desc": "10 solicitudes: 6 ACCEPTED, 2 REJECTED, 2 PENDING",
    "den_desc": "grants: 5 ACTIVE + 1 FAILED sobre 6 aprobadas",
    "sample_value": 10,
    "states": {
      "requests": {
        "ACCEPTED": 6,
        "REJECTED": 2,
        "PENDING": 2
      },
      "grants": {
        "ACTIVE": 5,
        "FAILED": 1
      }
    },
    "scope_note": "Cuenta estados; no determina si la concesión de acceso fue apropiada."
  },
  {
    "id": "M-07",
