    "kind": "pct",
    "num": 95,
    "den": 100,
    "unit": "%",
    "num_desc": "95 registros completos",
    "den_desc": "100 registros examinados",
    "sample_value": 95,
    "states": null,
    "scope_note": "Revisa campos de los registros disponibles; no prueba que se hayan capturado todos los eventos."
  },
