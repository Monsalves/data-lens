  {
    "id": "M-27",
    "name": "Intervenciones del guardrail en pruebas",
    "pillar": "Cumplimiento y privacidad",
    "dimension": "Privacidad E/S",
    "reference": "Batería sintética de 20 entradas y salidas enviada al guardrail del ejemplo.",
    "operations": [
      {
        "name": "ApplyGuardrail",
        "service": "Amazon Bedrock Runtime",
        "method": "POST",
        "endpoint": "https://bedrock-runtime.{region}.amazonaws.com/guardrail/{guardrailIdentifier}/version/{guardrailVersion}/apply",
        "fields": [
          "action",
          "actionReason",
          "assessments[].appliedGuardrailDetails.guardrailVersion",
          "assessments[].contentPolicy.filters[].{action,confidence,detected,filterStrength,type}",
          "assessments[].sensitiveInformationPolicy.piiEntities[].{action,detected,type}"
        ],
        "docs": "https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_ApplyGuardrail.html"
      }
    ],
    "formula": "casos con intervención ÷ casos de prueba",
    "kind": "pct",
    "num": 18,
    "den": 20,
    "unit": "%",
    "num_desc": "18 casos con intervención",
    "den_desc": "20 casos de prueba",
    "sample_value": 90,
    "states": null,
    "scope_note": "Cuenta acciones observadas en esta batería; no demuestra eficacia general ni cumplimiento."
  },
  {
    "id": "M-29",
    "name": "Reglas de ciclo de vida activas",
    "pillar": "Cumplimiento y privacidad",
    "dimension": "Retención",
    "reference": "Buckets consultados y estado de sus reglas de ciclo de vida.",
