      {
        "name": "GetBucketLifecycleConfiguration",
        "service": "Amazon S3",
        "method": "GET",
        "endpoint": "https://{bucket}.s3.{region}.amazonaws.com/?lifecycle",
        "fields": [
          "Rules[].ID",
          "Rules[].Status",
          "Rules[].Filter",
          "Rules[].Expiration",
          "Rules[].NoncurrentVersionExpiration"
        ],
        "docs": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketLifecycleConfiguration.html"
      }
    ],
    "formula": "buckets con regla activa ÷ buckets consultados",
    "kind": "pct",
    "num": 9,
    "den": 10,
    "unit": "%",
    "num_desc": "9 buckets con regla activa",
    "den_desc": "10 buckets consultados",
    "sample_value": 90,
    "states": null,
    "scope_note": "La presencia de una regla no determina si el plazo de conservación es adecuado."
  }
]
