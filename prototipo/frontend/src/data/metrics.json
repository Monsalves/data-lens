        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_GetAsset.html"
      }
    ],
    "formula": "pares activo-campo informados ÷ pares aplicables",
    "kind": "pct",
    "num": 90,
    "den": 100,
    "unit": "%",
    "num_desc": "90 pares con valor no vacío",
    "den_desc": "100 pares (20 activos × 5 campos)",
    "sample_value": 90,
    "states": null,
    "scope_note": "Comprueba presencia de valores; no valida que su contenido sea correcto."
  },
  {
    "id": "M-09",
    "name": "Tramos de linaje registrados",
    "pillar": "Visibilidad",
    "dimension": "Linaje",
    "reference": "Conexiones devueltas por el grafo de linaje consultado.",
    "operations": [
      {
        "name": "GetLineageNode",
        "service": "Amazon DataZone",
        "method": "GET",
        "endpoint": "https://datazone.{region}.api.aws/v2/domains/{domainIdentifier}/lineage/nodes/{identifier}",
        "fields": [
          "id",
          "sourceIdentifier",
          "upstreamNodes[].id",
          "downstreamNodes[].id",
          "eventTimestamp"
        ],
        "docs": "https://docs.aws.amazon.com/datazone/latest/APIReference/API_GetLineageNode.html"
      }
    ],
    "formula": "conteo de conexiones registradas en la consulta",
    "kind": "count",
    "num": 8,
    "den": 0,
    "unit": "tramos",
    "num_desc": "8 conexiones registradas en el grafo de ejemplo",
    "den_desc": "Sin referencia de tramos esperados",
    "sample_value": 8,
    "states": null,
    "scope_note": "No se infiere qué conexiones faltan ni se calcula cobertura sin una referencia independiente."
  },
  {
    "id": "M-11",
    "name": "Filas que fallan una regla de completitud",
    "pillar": "Calidad",
    "dimension": "Reglas de calidad",
    "reference": "Regla DQDL de completitud y resultado agregado del lote consultado.",
    "operations": [
      {
        "name": "GetDataQualityRuleset",
        "service": "AWS Glue",
        "method": "POST",
        "endpoint": "https://glue.{region}.amazonaws.com/; X-Amz-Target: AWSGlue.GetDataQualityRuleset",
        "fields": [
          "Ruleset",
          "TargetTable",
          "CreatedOn",
          "LastModifiedOn",
          "Name"
        ],
        "docs": "https://docs.aws.amazon.com/glue/latest/webapi/API_GetDataQualityRuleset.html"
      },
      {
        "name": "GetDataQualityResult",
        "service": "AWS Glue",
        "method": "POST",
        "endpoint": "https://glue.{region}.amazonaws.com/; X-Amz-Target: AWSGlue.GetDataQualityResult",
        "fields": [
          "AggregatedMetrics.TotalRowsProcessed",
          "AggregatedMetrics.TotalRowsPassed",
          "AggregatedMetrics.TotalRowsFailed",
          "AggregatedMetrics.TotalRulesProcessed",
          "AggregatedMetrics.TotalRulesPassed",
          "RuleResults[].Name",
          "RuleResults[].Result",
          "RuleResults[].RuleMetrics"
        ],
        "docs": "https://docs.aws.amazon.com/glue/latest/webapi/API_GetDataQualityResult.html"
      }
    ],
    "formula": "filas fallidas en la regla ÷ filas procesadas",
    "kind": "pct",
    "num": 10,
    "den": 100,
    "unit": "%",
    "num_desc": "10 filas fallidas según la regla",
    "den_desc": "100 filas procesadas por la regla",
    "sample_value": 10,
    "states": null,
    "scope_note": "Glue entrega conteos por regla; los identificadores de fila de esta demo no provienen de esa API."
  },
  {
    "id": "M-16",
    "name": "Éxito de ejecuciones",
    "pillar": "Calidad",
    "dimension": "Pipelines",
    "reference": "Periodo, estados terminales y tratamiento de reintentos.",
    "operations": [
      {
        "name": "GetJobRuns",
        "service": "AWS Glue",
        "method": "POST",
        "endpoint": "https://glue.{region}.amazonaws.com/; X-Amz-Target: AWSGlue.GetJobRuns",
        "fields": [
          "NextToken",
          "JobRuns[].JobRunState",
          "JobRuns[].StartedOn",
          "JobRuns[].CompletedOn",
          "JobRuns[].ExecutionTime"
        ],
        "docs": "https://docs.aws.amazon.com/glue/latest/webapi/API_GetJobRuns.html"
      }
    ],
    "formula": "terminales exitosas ÷ terminales de la cohorte",
    "kind": "pct",
    "num": 18,
    "den": 20,
    "unit": "%",
    "num_desc": "18 SUCCEEDED",
    "den_desc": "20 terminales (18+2); 3 RUNNING fuera del denominador",
    "sample_value": 90,
    "states": null,
    "scope_note": "Incluye ejecuciones terminales del job consultado; no mide la calidad de los datos producidos."
  },
  {
    "id": "M-18",
    "name": "Reglas de calidad con resultado",
    "pillar": "Calidad",
    "dimension": "Curación",
    "reference": "Reglas del ruleset y resultados de la evaluación consultada.",
    "operations": [
      {
        "name": "GetDataQualityRuleset",
        "service": "AWS Glue",
        "method": "POST",
        "endpoint": "https://glue.{region}.amazonaws.com/; X-Amz-Target: AWSGlue.GetDataQualityRuleset",
        "fields": [
          "Ruleset",
          "TargetTable",
          "CreatedOn",
          "LastModifiedOn",
          "Name"
        ],
        "docs": "https://docs.aws.amazon.com/glue/latest/webapi/API_GetDataQualityRuleset.html"
      },
      {
        "name": "GetDataQualityResult",
        "service": "AWS Glue",
        "method": "POST",
        "endpoint": "https://glue.{region}.amazonaws.com/; X-Amz-Target: AWSGlue.GetDataQualityResult",
        "fields": [
          "AggregatedMetrics.TotalRowsProcessed",
          "AggregatedMetrics.TotalRowsPassed",
          "AggregatedMetrics.TotalRowsFailed",
          "AggregatedMetrics.TotalRulesProcessed",
          "AggregatedMetrics.TotalRulesPassed",
          "RuleResults[].Name",
          "RuleResults[].Result",
          "RuleResults[].RuleMetrics"
        ],
        "docs": "https://docs.aws.amazon.com/glue/latest/webapi/API_GetDataQualityResult.html"
      }
    ],
    "formula": "reglas con resultado ÷ reglas configuradas",
    "kind": "pct",
    "num": 8,
    "den": 10,
    "unit": "%",
    "num_desc": "8 reglas con resultado",
    "den_desc": "10 reglas configuradas",
    "sample_value": 80,
    "states": null,
    "scope_note": "Mide disponibilidad del resultado; no afirma que las reglas cubran todos los riesgos."
  },
  {
    "id": "M-21",
    "name": "Hallazgos de permisos no utilizados",
    "pillar": "Acceso y seguridad",
    "dimension": "Acceso mínimo",
    "reference": "Analyzer de acceso no utilizado, estado y ventana observada.",
    "operations": [
      {
        "name": "ListFindingsV2",
        "service": "IAM Access Analyzer",
        "method": "POST",
        "endpoint": "https://access-analyzer.{region}.amazonaws.com/findingv2",
        "fields": [
          "findings[].findingType",
          "findings[].status",
          "findings[].resource",
          "findings[].resourceType",
          "findings[].createdAt"
        ],
        "docs": "https://docs.aws.amazon.com/access-analyzer/latest/APIReference/API_ListFindingsV2.html"
      }
    ],
    "formula": "findings de uso no utilizado en la ventana",
    "kind": "count",
    "num": 8,
    "den": 0,
    "unit": "hallazgos",
    "num_desc": "8 UNUSED_PERMISSION activos",
    "den_desc": "ventana de 90 días",
    "sample_value": 8,
    "states": null,
    "scope_note": "Cuenta hallazgos activos del analizador consultado; no equivale a todos los permisos de la cuenta."
  },
  {
    "id": "M-22",
    "name": "Objetos con cifrado SSE-KMS registrado",
    "pillar": "Acceso y seguridad",
    "dimension": "Protección",
    "reference": "Objetos o versiones inspeccionados y algoritmo de cifrado informado por S3.",
    "operations": [
      {
        "name": "HeadObject",
        "service": "Amazon S3",
        "method": "HEAD",
        "endpoint": "https://{bucket}.s3.{region}.amazonaws.com/{Key+}",
        "fields": [
          "x-amz-server-side-encryption",
          "x-amz-server-side-encryption-aws-kms-key-id",
          "x-amz-server-side-encryption-bucket-key-enabled",
          "x-amz-version-id",
          "x-amz-object-lock-mode"
        ],
        "docs": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_HeadObject.html"
      }
    ],
    "formula": "objetos con SSE-KMS ÷ objetos inspeccionados",
    "kind": "pct",
    "num": 90,
    "den": 100,
    "unit": "%",
    "num_desc": "90 objetos con SSE-KMS informado",
    "den_desc": "100 objetos inspeccionados",
    "sample_value": 90,
    "states": null,
    "scope_note": "SSE-S3 también cifra; sin una política aplicable no se determina conformidad."
  },
